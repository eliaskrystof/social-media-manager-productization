    {
      "parameters": {
        "jsCode": "const input = $json;\n\nfunction normalize(value) {\n  if (value === null || value === undefined) return '';\n  return String(value)\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/\\r/g, '\\n')\n    .trim();\n}\n\nconst changed_fields = {};\nconst old_fields = {};\nconst changed_keys = [];\nconst unchanged_keys = [];\n\nfor (const key of Object.keys(input)) {\n\n  if (!key.endsWith('_parsed')) continue;\n\n  const baseKey = key.replace('_parsed', '');\n\n  if (!(baseKey in input)) continue;\n\n  const actualRaw = input[baseKey];\n  const parsedRaw = input[key];\n\n  const actualValue = normalize(actualRaw);\n  const parsedValue = normalize(parsedRaw);\n\n  if (actualValue !== parsedValue) {\n\n    changed_fields[baseKey] = parsedRaw;\n    old_fields[baseKey] = actualRaw;\n\n    changed_keys.push(baseKey);\n\n  } else {\n    unchanged_keys.push(baseKey);\n  }\n}\n\nreturn [{\n  json: {\n    source_row: input.source_row,\n    language: input.language,\n\n    has_changes: changed_keys.length > 0,\n\n    changed_keys,\n    changed_fields,\n    old_fields,\n    unchanged_keys\n  }\n}];"
