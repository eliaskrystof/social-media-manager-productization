    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const html = String($json.html_content ?? $json.data ?? \"\");\nconst language = String($('Trigger').item.json.language ?? '').trim().toLowerCase();\n\n// 0) pevné mapování n8n language -> hreflang\nconst hreflangMap = {\n  czech: 'cs',\n  english: 'en',\n  polish: 'pl',\n  german: 'de',\n};\n\nconst wantedLang = hreflangMap[language] || 'cs';\n\n// 0.1) pokud je HTML escapované jako \\\"\nconst normalizedHtml = html.replace(/\\\\\"/g, '\"');\n\n// 0.2) najdi správný alternate hreflang link\nconst hreflangMatches = [...normalizedHtml.matchAll(\n  /<link[^>]+rel=[\"']alternate[\"'][^>]+hreflang=[\"']([^\"']+)[\"'][^>]+href=[\"']([^\"']+)[\"'][^>]*\\/?>/gi\n)];\n\nlet blog_url = '';\n\nfor (const match of hreflangMatches) {\n  const hreflang = String(match[1] || '').toLowerCase();\n  const href = String(match[2] || '');\n\n  if (hreflang === wantedLang) {\n    blog_url = href;\n    break;\n  }\n}\n\n// fallback na původní blog URL z Triggeru\nif (!blog_url) {\n  blog_url = String($('Trigger').item.json.blog ?? '');\n}\n\n// 1) vyhoď věci, co jen nafukují tokeny\nlet s = html\n  .replace(/<script\\b[\\s\\S]*?<\\/script>/gi, \" \")\n  .replace(/<style\\b[\\s\\S]*?<\\/style>/gi, \" \")\n  .replace(/<noscript\\b[\\s\\S]*?<\\/noscript>/gi, \" \")\n  .replace(/<svg\\b[\\s\\S]*?<\\/svg>/gi, \" \")\n  .replace(/<!--([\\s\\S]*?)-->/g, \" \");\n\n// 2) hrubě pryč s navigací / patičkou / cookie lištami\ns = s\n  .replace(/<header\\b[\\s\\S]*?<\\/header>/gi, \" \")\n  .replace(/<nav\\b[\\s\\S]*?<\\/nav>/gi, \" \")\n  .replace(/<footer\\b[\\s\\S]*?<\\/footer>/gi, \" \")\n  .replace(/<aside\\b[\\s\\S]*?<\\/aside>/gi, \" \")\n  .replace(/cookie(s)?|privacy|gdpr|consent|preferences|analytics|marketing/gi, \" \");\n\n// 3) převod na text s rozumnými oddělovači\ns = s\n  .replace(/<br\\s*\\/?>/gi, \"\\n\")\n  .replace(/<\\/(p|div|section|article|main|h1|h2|h3|h4|li|ul|ol)>/gi, \"\\n\")\n  .replace(/<[^>]+>/g, \" \");\n\n// 4) decode základních HTML entit\ns = s\n  .replace(/&nbsp;/gi, \" \")\n  .replace(/&amp;/gi, \"&\")\n  .replace(/&quot;/gi, '\"')\n  .replace(/&#0*39;/gi, \"'\")\n  .replace(/&lt;/gi, \"<\")\n  .replace(/&gt;/gi, \">\");\n\n// 5) normalizace whitespace\nconst page_text = s\n  .replace(/[ \\t]+/g, \" \")\n  .replace(/\\n[ \\t]+/g, \"\\n\")\n  .replace(/\\n{3,}/g, \"\\n\\n\")\n  .trim();\n\nreturn {\n  ...$json,\n  blog_url,\n  page_text,\n  _debug: {\n    language,\n    wantedLang,\n    hreflangFound: !!blog_url,\n    inputLen: html.length,\n    outputLen: page_text.length,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
