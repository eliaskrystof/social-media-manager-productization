    {
      "parameters": {
        "jsCode": "const items = $input.all();   // all incoming items\nconst out = [];\n\nfor (const item of items) {\n  const lang = item.json;\n\n  const base = {\n    rowNumber: lang.rowNumber,\n    language: lang.language,\n  };\n\n  if (lang.blog?.change) {\n    out.push({\n      json: {\n        ...base,\n        section: 'blog',\n        data: lang.blog,\n      },\n    });\n  }\n\n  if (lang.project?.change) {\n    out.push({\n      json: {\n        ...base,\n        section: 'project',\n        data: lang.project,\n      },\n    });\n  }\n\n  if (lang.collection?.change) {\n    out.push({\n      json: {\n        ...base,\n        section: 'collection',\n        data: lang.collection,\n      },\n    });\n  }\n\n  if (lang.pattern?.change) {\n    out.push({\n      json: {\n        ...base,\n        section: 'pattern',\n        data: lang.pattern,\n      },\n    });\n  }\n}\n\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
