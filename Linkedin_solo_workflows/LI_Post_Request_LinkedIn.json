    {
      "parameters": {
        "jsCode": "// --- Inputs ---\nconst linkedinUserId = $node[\"Get Credentials\"].json.linkedin_id;\nconst videoAsset = $node[\"HTTP Request Register Video\"].json.value.asset; // uploaded asset URN\nconst caption = $node[\"Get a row\"].json.linkedIn_text || \"Sharing a new video update!\";\n\n// --- Build the LinkedIn UGC Post body ---\nconst body = {\n  author: `urn:li:person:${linkedinUserId}`,\n  lifecycleState: \"PUBLISHED\",\n  specificContent: {\n    \"com.linkedin.ugc.ShareContent\": {\n      shareCommentary: {\n        text: caption\n      },\n      shareMediaCategory: \"VIDEO\",\n      media: [\n        {\n          status: \"READY\",\n          media: videoAsset,\n          description: { text: \"Video post\" },\n          title: { text: \"LinkedIn Video Upload\" }\n        }\n      ]\n    }\n  },\n  visibility: {\n    \"com.linkedin.ugc.MemberNetworkVisibility\": \"PUBLIC\"\n  }\n};\n\n// --- Output to next node ---\nreturn [{ json: body }];"
      },
      "type": "n8n-nodes-base.code",
