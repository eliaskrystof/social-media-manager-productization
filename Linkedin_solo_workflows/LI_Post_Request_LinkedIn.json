    {
      "parameters": {
        "jsCode": "const linkedinUserId = $node[\"Get Credentials\"].json.linkedin_id;\n\nlet assetsRaw = $json.media ?? $json.asset ?? [];\nif (!Array.isArray(assetsRaw)) assetsRaw = [assetsRaw];\n\n// normalize to URN strings\nconst assetUrns = assetsRaw.map(a => {\n  if (typeof a === \"string\") return a;\n  if (a && typeof a.media === \"string\") return a.media;\n  return null;\n}).filter(Boolean);\n\nconst mediaCategory = assetUrns.length ? \"IMAGE\" : \"NONE\";\n\nreturn [{\n  json: {\n    author: `urn:li:person:${linkedinUserId}`,\n    lifecycleState: \"PUBLISHED\",\n    specificContent: {\n      \"com.linkedin.ugc.ShareContent\": {\n        shareCommentary: {\n          text: $node[\"Get a row\"].json.linkedIn_text\n        },\n        shareMediaCategory: mediaCategory,\n        media: assetUrns.map((urn) => ({\n          status: \"READY\",\n          media: urn\n        }))\n      }\n    },\n    visibility: {\n      \"com.linkedin.ugc.MemberNetworkVisibility\": \"PUBLIC\"\n    },\n    distribution: {\n      linkedInDistributionTarget: {}\n    }\n  }\n}];\n"
      },
