    {
      "parameters": {
        "mode": "expression",
        "output": "={{\n(() => {\n  const arr = $('Get a row').item.json.instagram_attachments || [];   // original array (strings)\n  const total = arr.length;\n  const hasVideo = arr.some(s => String(s).includes('/video'));      // does the array contain any video?\n  const cur = String($json.instagram_attachments || '');              // current item (string from Split Out)\n\n  return (hasVideo && cur.includes('/video')) ? 0        // Case 1: array has video AND this item is video  → Out 1\n       : (!hasVideo && total === 1) ? 1                  // Case 2: array has no video AND length = 1      → Out 2\n       : (!hasVideo && total > 1) ? 2                    // Case 3: array has no video AND length > 1      → Out 3\n       : 3;                                              // Fallback (e.g., image in mixed set)             → Out 4\n})()\n}}"
      },
