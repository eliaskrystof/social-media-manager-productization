    {
      "parameters": {
        "jsCode": "// Grab the LinkedIn user id from \"Get Credentials\" node\nconst linkedinUserId = $node[\"Get Credentials\"].json.linkedin_user_id;\n\n// Grab the aggregated asset array (e.g. from Aggregate node)\nconst assets = $json.media || [$json.asset];  // handles array or single asset\n\n// Build the full LinkedIn post body\nreturn [\n  {\n    json: {\n      author: `urn:li:person:${linkedinUserId}`,\n      lifecycleState: \"PUBLISHED\",\n      specificContent: {\n        \"com.linkedin.ugc.ShareContent\": {\n          shareCommentary: {\n            text: $node[\"Get a row\"].json.caption_linkedin\n          },\n          shareMediaCategory: \"IMAGE\", // or VIDEO\n          media: assets.map(asset => ({\n            status: \"READY\",\n            media: asset,\n            description: { text: \"Optional description\" },\n            title: { text: \"Optional title\" }\n          }))\n        }\n      },\n      visibility: {\n        \"com.linkedin.ugc.MemberNetworkVisibility\": \"PUBLIC\"\n      }\n    }\n  }\n];\n"
      },
