    {
      "parameters": {
        "jsCode": "const ids = $input.all().map(item => item.json.id);\nconst access_token = $('Get Credentials').first().json.fb_access_token;\nconst row = $('Get a row').first().json;\n\nlet message = row.caption_facebook || '';\n\nif (row.hashtags) {\n  message += `\\n\\n${row.hashtags}`;\n}\n\nif (row.credits_facebook) {\n  message += `\\n\\n${row.credits_facebook}`;\n}\n\n// Build the URL-encoded string\nlet bodyString = `access_token=${encodeURIComponent(access_token)}&message=${encodeURIComponent(message)}`;\n\n// Add attached media dynamically\nids.forEach((id, index) => {\n  const mediaParam = JSON.stringify({ media_fbid: id });\n  bodyString += `&attached_media[${index}]=${encodeURIComponent(mediaParam)}`;\n});\n\nreturn [{\n  json: {\n    body: bodyString\n  }\n}];\n"
      },
